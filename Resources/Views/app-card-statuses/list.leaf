#extend("base"):
	#export("body"):
		<section class="page-header">
			<span class="section-label">#(meta.l10n.app_card_page_section_label)</span>
			<h2>#(meta.l10n.app_card_page_title)</h2>
		</section>

		<table class="table">
			<thead>
				<tr>
					<th>#(meta.l10n.app_card_column_scope)</th>
					<th>#(meta.l10n.app_card_column_status)</th>
					<th>#(meta.l10n.app_card_column_label)</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				#for(row in rows):
					<tr>
						<td>#(row.displayName)</td>
						<td>
							#if(row.configured):
								#if(row.enabled):
									<span class="tag tag-success">#(meta.l10n.app_card_status_enabled)</span>
								#else:
									<span class="tag tag-outline">#(meta.l10n.app_card_status_off)</span>
								#endif
							#else:
								<span class="tag tag-outline">#(meta.l10n.app_card_status_not_configured)</span>
							#endif
						</td>
						<td>#(row.label)</td>
						<td class="table-actions">
							<a class="icon-btn" href="#(meta.basePath)/app-card-statuses/edit?scope_value=#(row.scopeValue)"
								title="#if(row.configured): #(meta.l10n.common_action_edit) #else: #(meta.l10n.app_card_action_configure) #endif">
								<img src="#(meta.sharedURL)/static/img/icons/edit.svg" alt="#if(row.configured): #(meta.l10n.common_action_edit) #else: #(meta.l10n.app_card_action_configure) #endif">
							</a>
							#if(row.configured):
								<form action="#(meta.basePath)/app-card-statuses/#(row.id)/toggle" method="post" style="display:inline">
									<button type="submit" class="icon-btn tooltip-host" aria-label="#if(row.enabled): #(meta.l10n.app_card_action_disable) #else: #(meta.l10n.app_card_action_enable) #endif">
										#if(row.enabled):
											<img src="#(meta.sharedURL)/static/img/icons/cancel.svg" alt="">
										#else:
											<img src="#(meta.sharedURL)/static/img/icons/accept.svg" alt="">
										#endif
										<span class="tooltip" role="tooltip">
											<span class="tooltip-title">#if(row.enabled): #(meta.l10n.app_card_action_disable) #else: #(meta.l10n.app_card_action_enable) #endif</span>
										</span>
									</button>
								</form>
								<form action="#(meta.basePath)/app-card-statuses/#(row.id)/delete" method="post" style="display:inline" onsubmit="return confirm('#(meta.l10n.app_card_confirm_delete)')">
									<button type="submit" class="icon-btn icon-btn-danger tooltip-host" aria-label="#(meta.l10n.common_action_delete)">
										<span class="icon-mask" style="mask-image: url('#(meta.sharedURL)/static/svgs/fontawesome/solid/trash-alt.svg'); -webkit-mask-image: url('#(meta.sharedURL)/static/svgs/fontawesome/solid/trash-alt.svg');"></span>
										<span class="tooltip" role="tooltip">
											<span class="tooltip-title">#(meta.l10n.common_action_delete)</span>
										</span>
									</button>
								</form>
							#endif
						</td>
					</tr>
				#endfor
			</tbody>
		</table>
	#endexport
#endextend
