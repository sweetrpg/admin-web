#extend("base"):
	#export("body"):
		<section class="page-header">
			<span class="section-label">#(meta.l10n.users_page_section_label)</span>
			<h2>#(meta.l10n.entitlements_page_title)</h2>
			<p><a href="#(meta.basePath)/users">#(meta.l10n.entitlements_back_to_users)</a></p>
		</section>

		#if(errorMessage):
			<p class="form-error" role="alert">#(errorMessage)</p>
		#endif

		#if(unavailable):
			<p class="empty-state">#(meta.l10n.entitlements_unavailable)</p>
		#else:
			#if(notFound):
				<p class="empty-state">#(meta.l10n.entitlements_not_found)</p>
			#else:
				<table class="table entitlements-table">
					<thead>
						<tr>
							<th>#(meta.l10n.entitlements_column_key)</th>
							<th>#(meta.l10n.entitlements_column_type)</th>
							<th>#(meta.l10n.entitlements_effective)</th>
							<th>#(meta.l10n.entitlements_column_source)</th>
							<th>#(meta.l10n.entitlements_column_paid)</th>
							<th>#(meta.l10n.entitlements_column_actions)</th>
						</tr>
					</thead>
					<tbody>
						#for(row in rows):
							<tr>
								<td>#(row.key)</td>
								<td>#(row.type)</td>
								<td><strong>#(row.effective)</strong></td>
								<td><span class="tag tag-neutral">#(row.sourceHint)</span></td>
								<td>#if(row.hasPaid): <span class="tag tag-accent">#(meta.l10n.entitlements_paid_yes) #(row.paid)</span> #endif</td>
								<td class="table-actions">
									<a class="btn btn-secondary" data-dialog-open="dlg-#(row.key)" href="#(meta.basePath)/users/#(userID)/entitlements/#(row.key)">#(meta.l10n.entitlements_action_edit)</a>
								</td>
							</tr>
						#endfor
					</tbody>
				</table>

				#for(row in rows):
					<dialog class="dialog dialog-wide" id="dlg-#(row.key)" aria-labelledby="dlg-title-#(row.key)">
						<h3 class="dialog-title" id="dlg-title-#(row.key)">#(row.key)</h3>
						<div class="dialog-body">
							#extend("users/partials/entitlement-detail")
						</div>
						<div class="dialog-actions">
							<button type="button" class="btn btn-ghost" data-dialog-close>#(meta.l10n.common_cancel)</button>
						</div>
					</dialog>
				#endfor

				<section class="card">
					<h3>#(meta.l10n.entitlements_audit_title)</h3>
					#if(auditUnavailable):
						<p class="empty-state">#(meta.l10n.entitlements_audit_unavailable)</p>
					#else:
						<table class="table">
							<thead>
								<tr>
									<th>#(meta.l10n.entitlements_audit_when)</th>
									<th>#(meta.l10n.entitlements_audit_who)</th>
									<th>#(meta.l10n.entitlements_audit_key)</th>
									<th>#(meta.l10n.entitlements_audit_change)</th>
									<th>#(meta.l10n.entitlements_audit_reason)</th>
								</tr>
							</thead>
							<tbody>
								#for(a in audit):
									<tr><td>#(a.at)</td><td>#(a.actor)</td><td>#(a.key)</td><td>#(a.change)</td><td>#(a.reason)</td></tr>
								#endfor
							</tbody>
						</table>
					#endif
				</section>
			#endif
		#endif

		<script>
		(function () {
			// Progressive enhancement: without JavaScript the Edit link opens the single-key page.
			document.querySelectorAll('[data-dialog-open]').forEach(function (link) {
				link.addEventListener('click', function (event) {
					var dialog = document.getElementById(link.dataset.dialogOpen);
					if (dialog && dialog.showModal) { event.preventDefault(); dialog.showModal(); }
				});
			});
			document.querySelectorAll('dialog [data-dialog-close]').forEach(function (button) {
				button.addEventListener('click', function () { button.closest('dialog').close(); });
			});
			// Forms inside a dialog post with fetch: a redirect means success (reload); a page means
			// the confirmation or warning, which replaces the dialog body.
			function wire(root) {
				root.querySelectorAll('form[data-dialog-form]').forEach(function (form) {
					form.addEventListener('submit', function (event) {
						var body = form.closest('.dialog-body');
						if (!body || !window.fetch) { return; }
						event.preventDefault();
						fetch(form.action, { method: 'POST', credentials: 'same-origin', body: new URLSearchParams(new FormData(form)) })
							.then(function (response) {
								if (response.redirected) { window.location.href = response.url; return null; }
								return response.text();
							})
							.then(function (html) {
								if (html === null) { return; }
								var fragment = new DOMParser().parseFromString(html, 'text/html').getElementById('confirm-fragment');
								if (!fragment) { form.submit(); return; }
								body.innerHTML = fragment.innerHTML;
								wire(body);
								wireAck(body);
							})
							.catch(function () { form.submit(); });
					});
				});
			}
			// Submit stays disabled until the acknowledgment is ticked and a reference is entered.
			function wireAck(root) {
				var box = root.querySelector('#ack-checkbox');
				var ref = root.querySelector('#ack-reference');
				var btn = root.querySelector('#ack-submit');
				if (!box || !ref || !btn) { return; }
				function sync() { btn.disabled = !(box.checked && ref.value.trim() !== ''); }
				box.addEventListener('change', sync);
				ref.addEventListener('input', sync);
				sync();
			}
			wire(document);
		})();
		</script>
	#endexport
#endextend
