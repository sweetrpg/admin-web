#extend("base"):
	#export("body"):
		<section class="page-header">
			<span class="section-label">#(meta.l10n.users_page_section_label)</span>
			<h2>#(meta.l10n.users_page_title)</h2>
		</section>

		#if(unavailable):
			<p class="empty-state">#(meta.l10n.users_unavailable)</p>
		#endif

		#if(isEmpty):
			<p class="empty-state">#(meta.l10n.users_empty)</p>
		#endif

		#if(!unavailable):

		<table class="table">
			<thead>
				<tr>
					<th>#(meta.l10n.users_column_email)</th>
					<th>#(meta.l10n.users_column_roles)</th>
					<th>#(meta.l10n.users_column_denied_services)</th>
				</tr>
			</thead>
			<tbody>
				#for(u in users):
					<tr>
						<td>#(u.email)</td>
						<td>
							#for(role in u.roles):
								<span class="tag">#(role)
									<form action="#(meta.basePath)/users/#(u.id)/roles/#(role)/remove" method="post" style="display:inline">
										<button type="submit" class="btn btn-ghost btn-icon" aria-label="#(meta.l10n.users_remove_role_prefix)#(role)#(meta.l10n.users_remove_role_suffix)">&times;</button>
									</form>
								</span>
							#endfor
							#if(!u.availableRoles.isEmpty):
								<form action="#(meta.basePath)/users/#(u.id)/roles" method="post" style="display:inline-block">
									<select name="role">
										#for(role in u.availableRoles):
											<option value="#(role)">#(role)</option>
										#endfor
									</select>
									<button type="submit" class="btn btn-ghost">#(meta.l10n.users_action_add_role)</button>
								</form>
							#endif
						</td>
						<td>
							#for(service in u.deniedServices):
								<span class="tag tag-critical">#(service)
									<form action="#(meta.basePath)/users/#(u.id)/deny-entries/#(service)/remove" method="post" style="display:inline">
										<button type="submit" class="btn btn-ghost btn-icon" aria-label="#(meta.l10n.users_remove_deny_prefix)#(service)#(meta.l10n.users_remove_deny_suffix)">&times;</button>
									</form>
								</span>
							#endfor
							<form action="#(meta.basePath)/users/#(u.id)/deny-entries" method="post" style="display:inline-block">
								<input type="text" name="service" placeholder="#(meta.l10n.users_placeholder_service_name)" required>
								<button type="submit" class="btn btn-ghost">#(meta.l10n.users_action_deny_service)</button>
							</form>
						</td>
					</tr>
				#endfor
			</tbody>
		</table>
		#endif
	#endexport
#endextend
