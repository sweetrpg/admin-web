#extend("base"):
	#export("body"):
		<section class="page-header">
			<span class="section-label">#(meta.l10n.users_page_section_label)</span>
			<h2>#(meta.l10n.users_page_title)</h2>
		</section>

		#if(unavailable):
			<p class="empty-state">#(meta.l10n.users_unavailable)</p>
		#endif

		#if(refused):
			<p class="empty-state">#(meta.l10n.users_refused)#if(refusedMessage): #(meta.l10n.users_refused_detail) #(refusedMessage)#endif</p>
		#endif

		#if(isEmpty):
			<p class="empty-state">#(meta.l10n.users_empty)</p>
		#endif

		#if(!unavailable && !refused):

		<table class="table">
			<thead>
				<tr>
					<th>#(meta.l10n.users_column_email)</th>
					<th>#(meta.l10n.users_column_roles)</th>
					<th>#(meta.l10n.users_column_denied_services)</th>
					<th>#(meta.l10n.users_column_entitlements)</th>
				</tr>
			</thead>
			<tbody>
				#for(u in users):
					<tr>
						<td>#(u.email)
							<div class="tag-cloud">
							#for(identity in u.identities):
								<span class="tag tag-outline">#(identity)</span>
							#endfor
							</div>
						</td>
						<td>
							<div class="tag-cloud">
							#for(role in u.roles):
								<span class="tag tag-neutral tag-removable">#(role)
									<form action="#(meta.basePath)/users/#(u.id)/roles/#(role)/remove" method="post" style="display:inline" data-confirm="#(meta.l10n.users_confirm_remove_role_prefix)#(role)#(meta.l10n.users_confirm_remove_role_middle)#(u.email)#(meta.l10n.users_confirm_remove_role_suffix)" onsubmit="return confirm(this.dataset.confirm)">
										<button type="submit" class="tag-remove" aria-label="#(meta.l10n.users_remove_role_prefix)#(role)#(meta.l10n.users_remove_role_suffix)">&times;</button>
									</form>
								</span>
							#endfor
							</div>
							#if(!u.availableRoles.isEmpty):
								<form action="#(meta.basePath)/users/#(u.id)/roles" method="post" class="inline-controls" style="display:flex;gap:8px;align-items:center">
									<select class="input input-inline" name="role" aria-label="#(meta.l10n.users_field_role)">
										#for(role in u.availableRoles):
											<option value="#(role)">#(role)</option>
										#endfor
									</select>
									<button type="submit" class="btn btn-secondary">#(meta.l10n.users_action_add_role)</button>
								</form>
							#endif
						</td>
						<td>
							<div class="tag-cloud">
							#for(service in u.deniedServices):
								<span class="tag tag-critical tag-removable">#(service)
									<form action="#(meta.basePath)/users/#(u.id)/deny-entries/#(service)/remove" method="post" style="display:inline" data-confirm="#(meta.l10n.users_confirm_remove_deny_prefix)#(service)#(meta.l10n.users_confirm_remove_deny_middle)#(u.email)#(meta.l10n.users_confirm_remove_deny_suffix)" onsubmit="return confirm(this.dataset.confirm)">
										<button type="submit" class="tag-remove" aria-label="#(meta.l10n.users_remove_deny_prefix)#(service)#(meta.l10n.users_remove_deny_suffix)">&times;</button>
									</form>
								</span>
							#endfor
							</div>
							#if(servicesUnavailable):
								<p class="form-hint">#(meta.l10n.users_services_unavailable)</p>
							#else:
								<form action="#(meta.basePath)/users/#(u.id)/deny-entries" method="post" style="display:flex;gap:8px;align-items:center">
									<select class="input input-inline" name="service" aria-label="#(meta.l10n.users_field_service)" required>
										#for(service in services):
											<option value="#(service.id)">#(service.name)</option>
										#endfor
									</select>
									<button type="submit" class="btn btn-secondary">#(meta.l10n.users_action_deny_service)</button>
								</form>
							#endif
						</td>
						<td>
							#if(u.userID):
								<a href="#(meta.basePath)/users/#(u.userID)/entitlements">#(meta.l10n.users_action_entitlements)</a>
							#endif
						</td>
					</tr>
				#endfor
			</tbody>
		</table>
		#endif
	#endexport
#endextend
