#extend("base"):
	#export("body"):
		<section class="page-header">
			<span class="section-label">#if(isEdit): Edit #else: New #endif</span>
			<h2>Banner Message</h2>
		</section>

		<form class="form" action="#(formAction)" method="post" onsubmit="return validateBannerForm(this)">
			<label class="form-label" for="scope_type">Scope type</label>
			<select class="input" id="scope_type" name="scope_type" required>
				#for(scopeType in scopeTypes):
					<option value="#(scopeType)" #if(banner): #if(scopeType == banner.scopeType): selected #endif #endif>#(scopeType)</option>
				#endfor
			</select>

			<label class="form-label" for="scope_value">Scope value</label>
			<input class="input" type="text" id="scope_value" name="scope_value" placeholder="e.g. catalog or /catalog/browse (leave blank for platform scope)" value="#if(banner): #(banner.scopeValue) #endif">

			<label class="form-label" for="severity">Severity</label>
			<select class="input" id="severity" name="severity" required>
				#for(severity in severities):
					<option value="#(severity)" #if(banner): #if(severity == banner.severity): selected #endif #endif>#(severity)</option>
				#endfor
			</select>

			<label class="form-label" for="message">Message</label>
			<textarea class="input" id="message" name="message" rows="3" required>#if(banner): #(banner.message) #endif</textarea>

			<label class="form-label" for="starts_at">Starts at (optional)</label>
			<input class="input" type="datetime-local" id="starts_at" name="starts_at" value="#if(banner): #(banner.startsAt) #endif">

			<label class="form-label" for="expires_at">Expires at (required)</label>
			<input class="input" type="datetime-local" id="expires_at" name="expires_at" value="#if(banner): #(banner.expiresAt) #endif" required>
			<p class="form-error" id="expires-error" style="display:none">Expiration is required.</p>

			<button type="submit" class="btn btn-primary">#if(isEdit): Save changes #else: Create banner #endif</button>
		</form>

		<script>
			function validateBannerForm(form) {
				var expiresAt = form.querySelector('#expires_at');
				var error = document.getElementById('expires-error');
				if (!expiresAt.value) {
					error.style.display = 'block';
					expiresAt.focus();
					return false;
				}
				error.style.display = 'none';
				return true;
			}
		</script>
	#endexport
#endextend
