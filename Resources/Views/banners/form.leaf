#extend("base"):
	#export("body"):
		<section class="page-header">
			<span class="section-label">#if(isEdit): #(meta.l10n.banners_form_section_label_edit) #else: #(meta.l10n.banners_form_section_label_new) #endif</span>
			<h2>#(meta.l10n.banners_form_title)</h2>
		</section>

		<form class="form" action="#(formAction)" method="post" onsubmit="return validateBannerForm(this)">
			<label class="form-label" for="scope_type">#(meta.l10n.banners_field_scope_type)</label>
			<select class="input" id="scope_type" name="scope_type" required>
				#for(scopeType in scopeTypes):
					<option value="#(scopeType)" #if(scopeType == banner.scopeType): selected #endif>#(scopeType)</option>
				#endfor
			</select>

			<label class="form-label" for="scope_value">#(meta.l10n.banners_field_scope_value)</label>
			<input class="input" type="text" id="scope_value" name="scope_value" placeholder="#(meta.l10n.banners_placeholder_scope_value)" value="#(banner.scopeValue)">
			<p class="form-hint">#(meta.l10n.banners_hint_scope_value)</p>

			<label class="form-label" for="severity">#(meta.l10n.banners_field_severity)</label>
			<select class="input" id="severity" name="severity" required>
				#for(severity in severities):
					<option value="#(severity)" #if(severity == banner.severity): selected #endif>#(severity)</option>
				#endfor
			</select>

			<label class="form-label" for="message">#(meta.l10n.banners_field_message)</label>
			<textarea class="input" id="message" name="message" rows="3" required>#(banner.message)</textarea>

			<label class="form-label" for="starts_at">#(meta.l10n.banners_field_starts_at_optional)</label>
			<input class="input" type="datetime-local" id="starts_at" name="starts_at" value="#(banner.startsAt)">

			<label class="form-label" for="expires_at">#(meta.l10n.banners_field_expires_at_required)</label>
			<input class="input" type="datetime-local" id="expires_at" name="expires_at" value="#(banner.expiresAt)" required>
			<p class="form-error" id="expires-error" style="display:none">#(meta.l10n.banners_error_expires_required)</p>

			<div class="form-actions">
				<button type="submit" class="btn btn-primary">#if(isEdit): #(meta.l10n.banners_action_save_changes) #else: #(meta.l10n.banners_action_create_banner) #endif</button>
				<a class="btn btn-ghost" href="#(meta.basePath)/banners">#(meta.l10n.common_cancel)</a>
			</div>
		</form>

		<script>
			function validateBannerForm(form) {
				var expiresAt = form.querySelector('#expires_at');
				var error = document.getElementById('expires-error');
				if (!expiresAt.value) {
					error.style.display = 'block';
					expiresAt.focus();
					return false;
				}
				error.style.display = 'none';
				return true;
			}
		</script>
	#endexport
#endextend
