#extend("base"):
	#export("body"):
		<section class="page-header">
			<span class="section-label">#(meta.l10n.banners_page_section_label)</span>
			<h2>#(meta.l10n.banners_page_title)</h2>
			<a class="btn btn-primary" href="#(meta.basePath)/banners/new">#(meta.l10n.banners_action_new)</a>
		</section>

		<table class="table">
			<thead>
				<tr>
					<th>#(meta.l10n.banners_column_scope)</th>
					<th>#(meta.l10n.banners_column_severity)</th>
					<th>#(meta.l10n.banners_column_status)</th>
					<th>#(meta.l10n.banners_column_message)</th>
					<th>#(meta.l10n.banners_column_expires)</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				#if(isEmpty):
					<tr>
						<td class="empty-state table-empty" colspan="6">#(meta.l10n.banners_empty)</td>
					</tr>
				#endif
				#for(banner in banners):
					<tr>
						<td>#(banner.scopeLabel)</td>
						<td><span class="tag tag-#(banner.severity)">#(banner.severity)</span></td>
						<td><span class="tag tag-status-#(banner.status)">#(banner.status)</span></td>
						<td>#(banner.message)</td>
						<td>#(banner.expiresAtLabel)</td>
						<td class="table-actions">
							<a href="#(meta.basePath)/banners/#(banner.id)/edit" class="icon-btn tooltip-host" aria-label="#(meta.l10n.common_action_edit)"><span class="icon-mask" style="background-color: var(--color-text); mask-image: url('#(meta.sharedURL)/static/svgs/fontawesome/solid/pen.svg'); -webkit-mask-image: url('#(meta.sharedURL)/static/svgs/fontawesome/solid/pen.svg');"></span><span class="tooltip" role="tooltip"><span class="tooltip-title">#(meta.l10n.common_action_edit)</span><span class="tooltip-body">#(meta.l10n.banners_hint_edit)</span></span></a>
							<form action="#(meta.basePath)/banners/#(banner.id)/expire" method="post" style="display:inline">
								<button type="submit" class="icon-btn tooltip-host" aria-label="#(meta.l10n.banners_action_expire_now)"><span class="icon-mask" style="background-color: var(--color-text); mask-image: url('#(meta.sharedURL)/static/svgs/fontawesome/solid/hourglass-end.svg'); -webkit-mask-image: url('#(meta.sharedURL)/static/svgs/fontawesome/solid/hourglass-end.svg');"></span><span class="tooltip" role="tooltip"><span class="tooltip-title">#(meta.l10n.banners_action_expire_now)</span><span class="tooltip-body">#(meta.l10n.banners_hint_expire)</span></span></button>
							</form>
							<form action="#(meta.basePath)/banners/#(banner.id)/delete" method="post" style="display:inline" data-confirm="#(meta.l10n.banners_confirm_delete_prefix)#(banner.message)#(meta.l10n.banners_confirm_delete_suffix)" onsubmit="return confirm(this.dataset.confirm)">
								<button type="submit" class="icon-btn tooltip-host icon-btn-danger" aria-label="#(meta.l10n.common_action_delete)"><span class="icon-mask" style="mask-image: url('#(meta.sharedURL)/static/svgs/fontawesome/solid/trash-alt.svg'); -webkit-mask-image: url('#(meta.sharedURL)/static/svgs/fontawesome/solid/trash-alt.svg');"></span><span class="tooltip" role="tooltip"><span class="tooltip-title">#(meta.l10n.common_action_delete)</span><span class="tooltip-body">#(meta.l10n.banners_hint_delete)</span></span></button>
							</form>
						</td>
					</tr>
				#endfor
			</tbody>
		</table>
	#endexport
#endextend
