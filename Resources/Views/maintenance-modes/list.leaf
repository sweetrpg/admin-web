#extend("base"):
	#export("body"):
		<section class="page-header">
			<span class="section-label">#(meta.l10n.maintenance_page_section_label)</span>
			<h2>#(meta.l10n.maintenance_page_title)</h2>
		</section>

		<table class="table">
			<thead>
				<tr>
					<th>#(meta.l10n.maintenance_column_scope)</th>
					<th>#(meta.l10n.maintenance_column_status)</th>
					<th>#(meta.l10n.maintenance_column_label)</th>
					<th>#(meta.l10n.maintenance_column_starts)</th>
					<th>#(meta.l10n.maintenance_column_ends)</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				#for(row in rows):
					<tr>
						<td>#(row.displayName)</td>
						<td>
							#if(row.configured):
								#if(row.enabled):
									<span class="tag tag-critical tooltip-host" tabindex="0">#(meta.l10n.maintenance_status_enabled)
										<span class="tooltip" role="tooltip">
											<span class="tooltip-title">#(meta.l10n.maintenance_status_enabled)</span>
											<span class="tooltip-body">#(meta.l10n.maintenance_status_enabled_desc)</span>
										</span>
									</span>
								#else:
									<span class="tag tag-outline tooltip-host" tabindex="0">#(meta.l10n.maintenance_status_off)
										<span class="tooltip" role="tooltip">
											<span class="tooltip-title">#(meta.l10n.maintenance_status_off)</span>
											<span class="tooltip-body">#(meta.l10n.maintenance_status_off_desc)</span>
										</span>
									</span>
								#endif
								#if(row.isStale):
									<span class="tag tag-status-expired tooltip-host" tabindex="0">#(meta.l10n.maintenance_status_past_end_date)
										<span class="tooltip" role="tooltip">
											<span class="tooltip-title">#(meta.l10n.maintenance_status_past_end_date)</span>
											<span class="tooltip-body">#(meta.l10n.maintenance_status_past_end_date_desc)</span>
										</span>
									</span>
								#endif
							#else:
								<span class="tag tag-outline tooltip-host" tabindex="0">#(meta.l10n.maintenance_status_not_configured)
									<span class="tooltip" role="tooltip">
										<span class="tooltip-title">#(meta.l10n.maintenance_status_not_configured)</span>
										<span class="tooltip-body">#(meta.l10n.maintenance_status_not_configured_desc)</span>
									</span>
								</span>
							#endif
						</td>
						<td>#(row.label)</td>
						<td title="#(row.startsAtRfc)">#(row.startsAtLabel)</td>
						<td title="#(row.endsAtRfc)">#(row.endsAtLabel)</td>
						<td class="table-actions">
							<a class="icon-btn" href="#(meta.basePath)/maintenance-modes/edit?scope_type=#(row.scopeType)&scope_value=#(row.scopeValue)"
								title="#if(row.configured): #(meta.l10n.common_action_edit) #else: #(meta.l10n.maintenance_action_configure) #endif">
								<img src="#(meta.sharedURL)/static/img/icons/edit.svg" alt="#if(row.configured): #(meta.l10n.common_action_edit) #else: #(meta.l10n.maintenance_action_configure) #endif">
							</a>
							#if(row.configured):
								<form action="#(meta.basePath)/maintenance-modes/#(row.id)/toggle" method="post" style="display:inline">
									<button type="submit" class="icon-btn tooltip-host" aria-label="#if(row.enabled): #(meta.l10n.maintenance_action_disable) #else: #(meta.l10n.maintenance_action_enable) #endif">
										#if(row.enabled):
											<img src="#(meta.sharedURL)/static/img/icons/cancel.svg" alt="">
										#else:
											<img src="#(meta.sharedURL)/static/img/icons/accept.svg" alt="">
										#endif
										<span class="tooltip" role="tooltip">
											<span class="tooltip-title">#if(row.enabled): #(meta.l10n.maintenance_action_disable) #else: #(meta.l10n.maintenance_action_enable) #endif</span>
										</span>
									</button>
								</form>
								<form action="#(meta.basePath)/maintenance-modes/#(row.id)/delete" method="post" style="display:inline">
									<button type="submit" class="icon-btn icon-btn-danger tooltip-host" aria-label="#(meta.l10n.common_action_delete)">
										<span class="icon-mask" style="mask-image: url('#(meta.sharedURL)/static/svgs/fontawesome/solid/trash-alt.svg'); -webkit-mask-image: url('#(meta.sharedURL)/static/svgs/fontawesome/solid/trash-alt.svg');"></span>
										<span class="tooltip" role="tooltip">
											<span class="tooltip-title">#(meta.l10n.common_action_delete)</span>
										</span>
									</button>
								</form>
							#endif
						</td>
					</tr>
				#endfor
			</tbody>
		</table>
	#endexport
#endextend
