#extend("base"):
	#export("body"):
		<section class="page-header">
			<span class="section-label">#if(mode): Edit #else: Configure #endif</span>
			<h2>Maintenance Mode: #(displayName)</h2>
		</section>

		<form class="form" action="#(formAction)" method="post" onsubmit="return validateMaintenanceModeForm(this)">
			<input type="hidden" name="scope_type" value="#(scopeType)">
			<input type="hidden" name="scope_value" value="#(scopeValue)">

			<label class="form-label">
				<input type="checkbox" id="enabled" name="enabled" value="true" #if(mode): #if(mode.enabled): checked #endif #endif>
				Enabled (this is the explicit gate - dates below are informational only)
			</label>

			<label class="form-label" for="label">Label</label>
			<input class="input" type="text" id="label" name="label" placeholder="Short display text" value="#if(mode): #(mode.label) #endif" required>

			<label class="form-label" for="description">Description</label>
			<textarea class="input" id="description" name="description" rows="3" placeholder="Detail text for the tooltip/maintenance page" required>#if(mode): #(mode.description) #endif</textarea>

			<label class="form-label" for="starts_at">Starts at (required)</label>
			<input class="input" type="datetime-local" id="starts_at" name="starts_at" value="#if(mode): #(mode.startsAt) #endif" required>
			<p class="form-error" id="starts-error" style="display:none">Start date is required.</p>

			<label class="form-label" for="ends_at">Ends at (optional)</label>
			<input class="input" type="datetime-local" id="ends_at" name="ends_at" value="#if(mode): #(mode.endsAt) #endif">

			<button type="submit" class="btn btn-primary">Save</button>
		</form>

		<script>
			function validateMaintenanceModeForm(form) {
				var startsAt = form.querySelector('#starts_at');
				var error = document.getElementById('starts-error');
				if (!startsAt.value) {
					error.style.display = 'block';
					startsAt.focus();
					return false;
				}
				error.style.display = 'none';
				return true;
			}
		</script>
	#endexport
#endextend
