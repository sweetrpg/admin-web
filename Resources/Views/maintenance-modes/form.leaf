#extend("base"):
	#export("body"):
		<section class="page-header">
			<span class="section-label">#if(isEdit): #(meta.l10n.maintenance_form_section_label_edit) #else: #(meta.l10n.maintenance_form_section_label_configure) #endif</span>
			<h2>#(meta.l10n.maintenance_form_title_suffix) #(displayName)</h2>
		</section>

		<form class="form" action="#(formAction)" method="post" onsubmit="return validateMaintenanceModeForm(this)">
			<input type="hidden" name="scope_type" value="#(scopeType)">
			<input type="hidden" name="scope_value" value="#(scopeValue)">

			<label class="form-label" title="#(meta.l10n.maintenance_hint_enabled_title)">
				<input type="checkbox" id="enabled" name="enabled" value="true" #if(mode.enabled): checked #endif>
				#(meta.l10n.maintenance_field_enabled)
			</label>

			<label class="form-label" for="label">
				<input class="input" type="text" id="label" name="label" placeholder="#(meta.l10n.maintenance_placeholder_label)" value="#(mode.label)" required>
				#(meta.l10n.maintenance_field_label)
			</label>

	 		<label class="form-label" for="description">
                <textarea class="input" id="description" name="description" rows="3" placeholder="#(meta.l10n.maintenance_placeholder_description)" required>#(mode.description)</textarea>
				#(meta.l10n.maintenance_field_description)
				</label>

			<label class="form-label" for="starts_at">
            	<input class="input" type="datetime-local" id="starts_at" name="starts_at" value="#(mode.startsAt)" required>
    			<p class="form-error" id="starts-error" style="display:none">#(meta.l10n.maintenance_error_starts_required)</p>
    			#(meta.l10n.maintenance_field_starts_at)
			</label>

			<label class="form-label" for="ends_at">
				<input class="input" type="datetime-local" id="ends_at" name="ends_at" value="#(mode.endsAt)">
				#(meta.l10n.maintenance_field_ends_at)
			</label>

			<div class="form-actions">
				<button type="submit" class="btn btn-primary">#(meta.l10n.common_save)</button>
				<a class="btn btn-ghost" href="#(meta.basePath)/maintenance-modes">#(meta.l10n.common_cancel)</a>
			</div>
		</form>

		<script>
			function validateMaintenanceModeForm(form) {
				var startsAt = form.querySelector('#starts_at');
				var error = document.getElementById('starts-error');
				if (!startsAt.value) {
					error.style.display = 'block';
					startsAt.focus();
					return false;
				}
				error.style.display = 'none';
				return true;
			}
		</script>
	#endexport
#endextend
