#extend("base"):
	#export("body"):
		<section class="page-header">
			<span class="section-label">#if(isEdit): Edit #else: Configure #endif</span>
			<h2>Maintenance Mode: #(displayName)</h2>
		</section>

		<form class="form" action="#(formAction)" method="post" onsubmit="return validateMaintenanceModeForm(this)">
			<input type="hidden" name="scope_type" value="#(scopeType)">
			<input type="hidden" name="scope_value" value="#(scopeValue)">

			<label class="form-label" title="This is the explicit gate - dates below are informational only">
				<input type="checkbox" id="enabled" name="enabled" value="true" #if(mode.enabled): checked #endif>
				Enabled
			</label>

			<label class="form-label" for="label">Label</label>
			<input class="input" type="text" id="label" name="label" placeholder="Short display text" value="#(mode.label)" required>

			<label class="form-label" for="description">Description</label>
			<textarea class="input" id="description" name="description" rows="3" placeholder="Detail text for the tooltip/maintenance page" required>#(mode.description)</textarea>

			<label class="form-label" for="starts_at">Starts at (required)</label>
			<input class="input" type="datetime-local" id="starts_at" name="starts_at" value="#(mode.startsAt)" required>
			<p class="form-error" id="starts-error" style="display:none">Start date is required.</p>

			<label class="form-label" for="ends_at">Ends at (optional)</label>
			<input class="input" type="datetime-local" id="ends_at" name="ends_at" value="#(mode.endsAt)">

			<div class="form-actions">
				<button type="submit" class="btn btn-primary">Save</button>
				<a class="btn btn-ghost" href="#(meta.basePath)/maintenance-modes">Cancel</a>
			</div>
		</form>

		<script>
			function validateMaintenanceModeForm(form) {
				var startsAt = form.querySelector('#starts_at');
				var error = document.getElementById('starts-error');
				if (!startsAt.value) {
					error.style.display = 'block';
					startsAt.focus();
					return false;
				}
				error.style.display = 'none';
				return true;
			}
		</script>
	#endexport
#endextend
